# Oracle server: one Caddy for the web app, the API gateway, MCP and the PDF service.
# Domains come from deploy/oracle/.env (APP_DOMAIN, API_DOMAIN, MCP_DOMAIN, PDF_DOMAIN); Caddy gets and renews
# the HTTPS certificates itself. API routes and CORS mirror backend/services/gateway/Caddyfile (Railway).
# ALLOW_LOCALHOST_ORIGINS (default 1): 0 stops browsers on localhost / 127.0.0.1 from using the API (CORS) and
# from framing stored files. The owner tests the SPA from http://localhost:5176 against this API, so it is on.
{
	email {$ACME_EMAIL}
}

(hsts) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(strip_upstream_cors) {
	header_down -Access-Control-Allow-Origin
	header_down -Access-Control-Allow-Credentials
	header_down -Access-Control-Allow-Headers
	header_down -Access-Control-Allow-Methods
	header_down -Access-Control-Expose-Headers
}

# Web app (Vite build in /srv/app, single-page app).
{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip
	root * /srv/app

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	import hsts
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Report-only for now (browser console shows what an enforcing policy would block). Built from what the
		# app loads: API (auth/rest/storage/functions — AI calls go through it too) and PDF service; Wikipedia API
		# (process flow chart web reference); OSRM routing (location map); Google map tiles mt0-3.google.com and
		# the Google Maps embed (public home page); pdf.js worker and the service worker are same-origin.
		# Known reports before enforcing: inline <script> in index.html and in print / preview windows (needs
		# 'unsafe-inline' or hashes), and new Function in the Equipment Master formula field (needs a rewrite).
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{$API_DOMAIN} https://*.google.com https://*.gstatic.com https://*.googleapis.com; font-src 'self' data:; connect-src 'self' data: blob: https://{$API_DOMAIN} https://{$PDF_DOMAIN} https://en.wikipedia.org https://router.project-osrm.org https://routing.openstreetmap.de; frame-src 'self' blob: data: https://{$API_DOMAIN} https://maps.google.com https://www.google.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	try_files {path} /index.html
	file_server
}

# API gateway: auth / rest / storage / functions.
{$API_DOMAIN} {
	import hsts

	# Local Vite origins, unless ALLOW_LOCALHOST_ORIGINS=0.
	@localDev {
		header_regexp Origin ^https?://(localhost|127\.0\.0\.1):(3000|517[3-9]|518[0-5])$
		not vars {env.ALLOW_LOCALHOST_ORIGINS} 0
	}
	header @localDev Access-Control-Allow-Origin "{http.request.header.Origin}"

	# Localhost may frame stored files only while localhost origins are allowed.
	map {env.ALLOW_LOCALHOST_ORIGINS} {local_frame_ancestors} {
		0 ""
		default "http://localhost:* http://127.0.0.1:*"
	}

	@app header Origin https://{$APP_DOMAIN}
	header @app Access-Control-Allow-Origin "https://{$APP_DOMAIN}"

	@appWww header Origin https://www.{$APP_DOMAIN}
	header @appWww Access-Control-Allow-Origin "https://www.{$APP_DOMAIN}"

	header {
		Access-Control-Allow-Credentials "true"
		Access-Control-Expose-Headers "Content-Range, Range, Content-Location, Content-Profile, Preference-Applied, X-Request-Id"
		Vary "Origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# Stored files (IS Code PDFs, product manuals, legal documents …) open in the app's own PDF viewer (an iframe),
	# so only these may be framed, and only by the app.
	@storageFile path /storage/v1/object/sign/* /storage/v1/object/public/* /storage/v1/object/authenticated/*
	header @storageFile {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors 'self' https://{$APP_DOMAIN} https://www.{$APP_DOMAIN} {local_frame_ancestors}"
	}

	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, apikey, Content-Type, Accept, Accept-Profile, Content-Profile, Prefer, Range, X-Client-Info, X-Supabase-Api-Version, X-Requested-With, Profile, X-User-Jwt, x-upsert, cache-control, content-disposition, X-Retry-Count"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	@health path /health
	handle @health {
		respond "ok" 200
	}

	@auth path /auth/v1 /auth/v1/*
	handle @auth {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999 {
			import strip_upstream_cors
		}
	}

	@rest path /rest/v1 /rest/v1/*
	handle @rest {
		encode zstd gzip
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000 {
			import strip_upstream_cors
		}
	}

	@storage path /storage/v1 /storage/v1/*
	handle @storage {
		uri strip_prefix /storage/v1
		reverse_proxy storage:5000 {
			import strip_upstream_cors
		}
	}

	@functions path /functions/v1 /functions/v1/*
	handle @functions {
		uri strip_prefix /functions/v1
		reverse_proxy functions:8080 {
			import strip_upstream_cors
		}
	}

	# Extension Manak PDF inbox (same path as on Railway).
	@manakPdf path /api/osl/manak-pdf /api/osl/manak-pdf/*
	handle @manakPdf {
		reverse_proxy functions:8080 {
			import strip_upstream_cors
		}
	}

	handle {
		respond "Not Found" 404
	}
}

# MCP server (it answers CORS / OAuth itself). Its OAuth login page must never be framed (clickjacking).
{$MCP_DOMAIN} {
	import hsts
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	reverse_proxy mcp:8090
}

# PDF service (it answers CORS and checks the user's session itself; large HTML bodies allowed).
{$PDF_DOMAIN} {
	import hsts
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	encode zstd gzip
	reverse_proxy pdf:3847
}
