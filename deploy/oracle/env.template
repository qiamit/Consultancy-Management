# deploy/oracle/.env — settings for the Oracle server. Never commit the real file (.env is git-ignored).
# scripts/make-env-from-railway.mjs fills the secrets from Railway so logins, the anon/service keys, MCP tokens
# and the extension keep working after the move. Values below in <> are placeholders.

# ── Domains ─────────────────────────────────────────────────────────────────────────────────────
# Before cutover: test names on the server IP, e.g. app.<IP>.sslip.io (real HTTPS certificates, no DNS change).
# At cutover: qengineering.in / api.qengineering.in / mcp.qengineering.in / pdf.qengineering.in
APP_DOMAIN=<app domain, without https://>
API_DOMAIN=<api domain>
MCP_DOMAIN=<mcp domain>
PDF_DOMAIN=<pdf domain>
ACME_EMAIL=info@qengineering.in

# ── Paths on the server ─────────────────────────────────────────────────────────────────────────
DATA_DIR=/opt/qe/data
BACKUP_DIR=/opt/qe/backups
STORAGE_BUCKET_DIR=qe-files

# ── Secrets (copied from Railway; the same JWT secret keeps every existing key valid) ────────────
POSTGRES_PASSWORD=<new strong password for the Oracle database>
JWT_SECRET=<from Railway auth.GOTRUE_JWT_SECRET>
JWT_EXPIRY=3600
ANON_KEY=<from Railway auth.ANON_KEY>
SERVICE_ROLE_KEY=<from Railway auth.SERVICE_ROLE_KEY>
MCP_TOKEN_KEY=<from Railway mcp.MCP_TOKEN_KEY>
MCP_ENABLED=true
MCP_WRITE_ENABLED=false

# ── Auth (GoTrue) ───────────────────────────────────────────────────────────────────────────────
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_URI_ALLOW_LIST=https://<app domain>/**,https://www.<app domain>/**
GOTRUE_PASSWORD_MIN_LENGTH=8
GOTRUE_MAILER_SUBJECTS_RECOVERY=Reset Your Password
GOTRUE_SMTP_ADMIN_EMAIL=
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_SENDER_NAME=

# ── REST ────────────────────────────────────────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=

# ── Functions (email, renewal reminders) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 1 = reminders off. Keep 1 until cutover (Railway still sends them), then set 0.
RENEWAL_REMINDERS_DISABLED=1

# ── Migration source (Railway) — used only by the migration scripts; remove after cutover ───────
SOURCE_DATABASE_URL=<Railway Postgres public URL, supabase_admin user>
SOURCE_S3_ENDPOINT=
SOURCE_S3_REGION=
SOURCE_S3_BUCKET=
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=
SOURCE_S3_FORCE_PATH_STYLE=true

# ── Optional off-server backup copy (rclone remote, e.g. Oracle Object Storage or Cloudflare R2) ──
BACKUP_RCLONE_REMOTE=
