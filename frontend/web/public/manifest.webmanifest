{
  "name": "Consultancy Pro",
  "short_name": "Consultancy Pro",
  "description": "BIS licensing, renewals, surveillance, IS codes, and finance for Q Engineering.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "standalone"
  ],
  "tab_strip": {
    "home_tab": {},
    "new_tab_button": {
      "url": "/"
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-new",
      "auto"
    ]
  },
  "background_color": "#f5f5f4",
  "theme_color": "#0c416a",
  "lang": "en",
  "icons": [
    {
      "src": "/brand/qe-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/qe-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
