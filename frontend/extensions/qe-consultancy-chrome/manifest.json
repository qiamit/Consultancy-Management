{
  "manifest_version": 3,
  "name": "QE Consultancy",
  "version": "2.2.33",
  "description": "Manak Test Request, Import QR, IS Code portal fetch, copy/paste bypass, and bulk field fill for Chrome, Edge, and other Chromium browsers.",
  "action": {
    "default_title": "QE Consultancy",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-bypass.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.manakonline.in/*",
        "https://manakonline.in/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.manakonline.in/*",
        "https://manakonline.in/*"
      ],
      "js": [
        "field-map.js",
        "captcha-assist.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.manakonline.in/*",
        "https://manakonline.in/*",
        "https://lims.bis.gov.in/*",
        "https://standards.bis.gov.in/*",
        "https://standardsbis.bsbedge.com/*"
      ],
      "js": [
        "captcha-assist.js",
        "is-code-fetch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "https://qengineering.in/*",
        "https://www.qengineering.in/*",
        "https://*.qengineering.in/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://play.google.com/*",
        "https://apps.apple.com/*"
      ],
      "js": [
        "close-play-store.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "scripting",
    "downloads",
    "declarativeNetRequest",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_bis_play_store",
        "enabled": true,
        "path": "block-rules.json"
      }
    ]
  }
}
