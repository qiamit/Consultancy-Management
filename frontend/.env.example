# Railway API gateway (Auth / REST / Storage)
# 1) Copy this file to `.env` in the frontend folder.
# 2) Use the Railway API URL only (not hosted supabase.co).
# 3) Real keys stay in `frontend/.env` — do not commit them.

VITE_SUPABASE_URL=https://api.qengineering.in
VITE_SUPABASE_ANON_KEY=Paste Railway anon key here
VITE_PDF_SERVICE_URL=https://pdf-service-xxxx.up.railway.app/pdf
