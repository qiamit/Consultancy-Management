# Copy to `.env` in this folder (never commit `.env`).
# Paths stay on your machine / shared drive — do not copy PDFs into the git repo.
# Fill real values later; placeholders only for now.

# Absolute path to the folder that contains BIS / IS PDF sources (outside the repo).
KNOWLEDGE_PDF_SOURCE_DIR=/absolute/path/to/bis-pdf-sources

# Absolute path where the local vector index will be stored (outside the repo preferred).
KNOWLEDGE_VECTOR_DB_PATH=/absolute/path/to/bis-vector-index

# Optional: client / firm documents used for firm-specific retrieval (outside the repo).
KNOWLEDGE_CLIENT_DOCS_DIR=/absolute/path/to/client-documents

# Optional embedding / LLM settings (wire up when indexing is enabled).
# KNOWLEDGE_EMBEDDING_PROVIDER=openai
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# KNOWLEDGE_OPENAI_API_KEY=
